{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/governed-registry-record.schema.json",
  "title": "Enki Governed Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_record_id", "registry_kind", "namespace", "version", "definition", "recorded_at", "lifecycle_status", "provenance_refs"],
  "properties": {
    "registry_record_id": {"type": "string", "minLength": 1},
    "registry_kind": {"type": "string", "enum": ["NORMALIZATION_PROFILE", "DERIVATION_PROFILE", "TAXONOMY_TERM", "SEMANTIC_MAPPING", "CONFLICT_CLASSIFICATION_RULE", "AUTHORITY_POLICY"]},
    "namespace": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "definition": {"type": "object"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "effective_from": {"type": ["string", "null"], "format": "date-time"},
    "effective_to": {"type": ["string", "null"], "format": "date-time"},
    "authority_from": {"type": ["string", "null"], "format": "date-time"},
    "authority_to": {"type": ["string", "null"], "format": "date-time"},
    "supersedes_ref": {"type": ["string", "null"]},
    "lifecycle_status": {"type": "string", "enum": ["CANDIDATE", "ACTIVE", "QUALIFIED", "SUPERSEDED", "REVOKED", "REJECTED", "RETIRED"]},
    "authority_ref": {"type": ["string", "null"]},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object", "default": {}}
  },
  "allOf": [
    {
      "if": {"properties": {"lifecycle_status": {"const": "ACTIVE"}}, "required": ["lifecycle_status"]},
      "then": {"required": ["authority_from"], "properties": {"authority_from": {"type": "string", "format": "date-time"}}}
    }
  ]
}