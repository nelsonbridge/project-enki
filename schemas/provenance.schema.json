{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/provenance.schema.json",
  "title": "Provenance Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "id",
    "schema_version",
    "recorded_at",
    "observer_id",
    "observer_type"
  ],
  "properties": {
    "record_type": {
      "const": "provenance"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "observer_id": {
      "type": "string",
      "minLength": 1
    },
    "observer_type": {
      "type": "string",
      "enum": [
        "human",
        "model",
        "system",
        "instrument"
      ]
    },
    "source_uri": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
