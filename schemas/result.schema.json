{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/result.schema.json",
  "title": "Result Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "id",
    "schema_version",
    "recorded_at",
    "experiment_ids"
  ],
  "properties": {
    "record_type": {
      "const": "result"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "experiment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_type",
          "id"
        ],
        "properties": {
          "record_type": {
            "enum": [
              "evidence",
              "observation",
              "hypothesis",
              "experiment",
              "result",
              "analysis",
              "subject",
              "provenance"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "supersedes_id": {
      "type": "string",
      "minLength": 1
    },
    "superseded_by_id": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
