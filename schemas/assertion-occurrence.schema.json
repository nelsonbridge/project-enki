{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/assertion-occurrence.schema.json",
  "title": "Enki Assertion Occurrence",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertion_occurrence_id", "subject", "proposition_ref", "claim_domain", "claim_type", "statement", "expression_origin", "confidence", "recorded_at", "provenance_refs"],
  "properties": {
    "assertion_occurrence_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "subject_type", "namespace"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "subject_type": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1}
      }
    },
    "proposition_ref": {"type": "string", "minLength": 1},
    "claim_domain": {"type": "string", "minLength": 1},
    "claim_type": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "derivation_batch_ref": {"type": ["string", "null"], "minLength": 1},
    "expression_origin": {"type": "string", "enum": ["SELF_DECLARED", "OBSERVED", "GOVERNED_INFERENCE"]},
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale"],
      "properties": {
        "level": {"type": "string", "enum": ["UNKNOWN", "LOW", "MODERATE", "HIGH"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "source_asserted_at": {"type": ["string", "null"], "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "context": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "default": []},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object", "default": {}}
  }
}