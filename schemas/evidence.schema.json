{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/evidence.schema.json",
  "title": "Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "id",
    "schema_version",
    "recorded_at",
    "provenance",
    "source_references"
  ],
  "properties": {
    "record_type": {
      "const": "evidence"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "id",
        "schema_version",
        "recorded_at",
        "observer_id",
        "observer_type"
      ],
      "properties": {
        "record_type": {
          "const": "provenance"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "observer_id": {
          "type": "string",
          "minLength": 1
        },
        "observer_type": {
          "type": "string",
          "enum": [
            "human",
            "model",
            "system",
            "instrument"
          ]
        },
        "source_uri": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes_id": {
      "type": "string",
      "minLength": 1
    },
    "superseded_by_id": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  }
}
