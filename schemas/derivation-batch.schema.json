{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/derivation-batch.schema.json",
  "title": "Enki Derivation Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["derivation_batch_id", "input_refs", "derivation_profile_ref", "attempts", "declared_scope", "coverage_manifest", "execution_status", "coverage_status", "assertion_manifest", "started_at", "provenance_refs"],
  "properties": {
    "derivation_batch_id": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "derivation_profile_ref": {"type": "string", "minLength": 1},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "ordinal", "status", "started_at"],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "ordinal": {"type": "integer", "minimum": 1},
          "status": {"type": "string", "enum": ["RUNNING", "SUCCEEDED", "PARTIAL", "FAILED"]},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": ["string", "null"], "format": "date-time"},
          "execution_ref": {"type": ["string", "null"]},
          "limitation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
          "error": {"type": ["string", "null"]},
          "metadata": {"type": "object", "default": {}}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["SUCCEEDED", "PARTIAL", "FAILED"]}}, "required": ["status"]},
            "then": {"required": ["completed_at"], "properties": {"completed_at": {"type": "string", "format": "date-time"}}}
          }
        ]
      }
    },
    "declared_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "coverage_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope_ref", "disposition"],
        "properties": {
          "scope_ref": {"type": "string", "minLength": 1},
          "disposition": {"type": "string", "enum": ["COMPLETE", "PARTIAL", "BLOCKED", "FAILED", "NOT_DUE", "UNKNOWN"]},
          "limitation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "execution_status": {"type": "string", "enum": ["NOT_STARTED", "RUNNING", "SUCCEEDED", "PARTIAL", "FAILED"]},
    "coverage_status": {"type": "string", "enum": ["NOT_ASSESSED", "COMPLETE", "PARTIAL", "BLOCKED", "FAILED", "UNKNOWN"]},
    "assertion_manifest": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object", "default": {}}
  },
  "allOf": [
    {
      "if": {"properties": {"execution_status": {"enum": ["SUCCEEDED", "PARTIAL", "FAILED"]}}, "required": ["execution_status"]},
      "then": {"required": ["completed_at"], "properties": {"completed_at": {"type": "string", "format": "date-time"}}}
    },
    {
      "if": {"properties": {"coverage_status": {"const": "COMPLETE"}}, "required": ["coverage_status"]},
      "then": {"properties": {"coverage_manifest": {"items": {"properties": {"disposition": {"const": "COMPLETE"}}}}}}
    }
  ]
}