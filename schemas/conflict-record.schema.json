{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/conflict-record.schema.json",
  "title": "Enki Conflict Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["conflict_id", "conflict_class", "detection_kind", "members", "classification_status", "provenance_refs", "detected_at"],
  "properties": {
    "conflict_id": {"type": "string", "minLength": 1},
    "conflict_class": {"type": "string", "enum": ["INTEGRITY", "SEMANTIC", "TEMPORAL", "AUTHORITY", "IDENTITY_RESOLUTION", "COVERAGE", "INTERPRETIVE"]},
    "detection_kind": {"type": "string", "minLength": 1},
    "members": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_kind", "ref_id"],
        "properties": {
          "ref_kind": {"type": "string", "minLength": 1},
          "ref_id": {"type": "string", "minLength": 1},
          "role": {"type": ["string", "null"]}
        }
      }
    },
    "classification_status": {"type": "string", "enum": ["DETECTED", "CANDIDATE", "CONFIRMED", "QUALIFIED", "DISMISSED", "UNRESOLVED", "SUPERSEDED"]},
    "classification": {"type": ["string", "null"]},
    "subject": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["subject_id", "subject_type", "namespace"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "subject_type": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1}
      }
    },
    "claim_domain": {"type": ["string", "null"]},
    "context": {"type": "array", "uniqueItems": true, "items": {"type": "string"}, "default": []},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "detected_at": {"type": "string", "format": "date-time"},
    "classified_at": {"type": ["string", "null"], "format": "date-time"},
    "authority_policy_ref": {"type": ["string", "null"]},
    "transition_ref": {"type": ["string", "null"]},
    "supersedes_ref": {"type": ["string", "null"]},
    "metadata": {"type": "object", "default": {}}
  },
  "allOf": [
    {
      "if": {"properties": {"classification_status": {"enum": ["CONFIRMED", "QUALIFIED", "DISMISSED", "SUPERSEDED"]}}, "required": ["classification_status"]},
      "then": {
        "required": ["classification", "classified_at"],
        "properties": {
          "classification": {"type": "string", "minLength": 1},
          "classified_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}